!define BLANK ""
e:\watcom\tsp\screen.obj : e:\watcom\tsp\screen.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 screen.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\sys.obj : e:\watcom\tsp\sys.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 sys.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\screent.exe : e:\watcom\tsp\screen.obj e:\watcom\tsp\sys.obj e&
:\watcom\tsp\screen.h e:\watcom\tsp\sys.h .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 @%write screent.lk1 NAME screent
 @%append screent.lk1 FIL screen.obj,sys.obj
 @%append screent.lk1 
 *wlink SYS dos4g op m d all op st=8192 op maxe=25 op q op symf @screent.lk1

