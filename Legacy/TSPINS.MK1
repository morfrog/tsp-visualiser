bt=dos

e:\watcom\tsp\tsp.obj : e:\watcom\tsp\tsp.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 tsp.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -4r -&
bt=dos

e:\watcom\tsp\tspins.exe : e:\watcom\tsp\file.obj e:\watcom\tsp\insert.obj e&
:\watcom\tsp\path.obj e:\watcom\tsp\problem.obj e:\watcom\tsp\screen.obj e:\&
watcom\tsp\sys.obj e:\watcom\tsp\tsp.obj e:\watcom\tsp\file.h e:\watcom\tsp\&
insert.h e:\watcom\tsp\path.h e:\watcom\tsp\problem.h e:\watcom\tsp\screen.h&
 e:\watcom\tsp\sys.h .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 @%write tspins.lk1 NAME tspins
 @%append tspins.lk1 FIL file.obj,insert.obj,path.obj,problem.obj,screen.obj&
,sys.obj,tsp.obj
 @%append tspins.lk1 
 *wlink SYS dos4g op m d all op st=8192 op maxe=25 op q op symf @tspins.lk1

