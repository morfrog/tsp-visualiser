!define BLANK ""
e:\watcom\tsp\file.obj : e:\watcom\tsp\file.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 file.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -4r &
-bt=dos

e:\watcom\tsp\insert.obj : e:\watcom\tsp\insert.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 insert.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -4&
r -bt=dos

e:\watcom\tsp\path.obj : e:\watcom\tsp\path.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 path.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -4r &
-bt=dos

e:\watcom\tsp\problem.obj : e:\watcom\tsp\problem.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 problem.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -&
4r -bt=dos

e:\watcom\tsp\screen.obj : e:\watcom\tsp\screen.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 screen.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -ol -om -oc -d2 -mf -4&
r -bt=dos

e:\watcom\tsp\sys.obj : e:\watcom\tsp\sys.c .AUTODEPEND
 @e:
