!define BLANK ""
e:\watcom\tsp\file.obj : e:\watcom\tsp\file.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 file.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\sys.obj : e:\watcom\tsp\sys.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 sys.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\bin.lib : e:\watcom\tsp\file.obj e:\watcom\tsp\sys.obj e:\watc&
om\tsp\file.h e:\watcom\tsp\sys.h .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 %create bin.lb1
!ifneq BLANK "file.obj sys.obj"
 @for %i in (file.obj sys.obj) do @%append bin.lb1 +'%i'
!endif
!ifneq BLANK ""
 @for %i in () do @%append bin.lb1 +'%i'
!endif
 *wlib -b -c -n -q -p=512 bin.lib @bin.lb1

