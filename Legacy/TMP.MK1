e:\watcom\tsp\tmp.exe : e:\watcom\tsp\file.obj e:\watcom\tsp\path.obj e:\wat&
com\tsp\problem.obj e:\watcom\tsp\sys.obj e:\watcom\tsp\file.h e:\watcom\tsp&
\path.h e:\watcom\tsp\problem.h e:\watcom\tsp\sys.h .AUTODEPEND
