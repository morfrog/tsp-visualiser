!define BLANK ""
e:\watcom\tsp\clocker.obj : e:\watcom\tsp\clocker.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 clocker.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\clocker.exe : e:\watcom\tsp\clocker.obj .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 @%write clocker.lk1 NAME clocker
 @%append clocker.lk1 FIL clocker.obj
 @%append clocker.lk1 
 *wlink SYS dos4g op m d all op st=8192 op maxe=25 op q op symf @clocker.lk1

