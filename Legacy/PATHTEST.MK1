!define BLANK ""
e:\watcom\tspins\path.obj : e:\watcom\tspins\path.c .AUTODEPEND
 @e:
 cd e:\watcom\tspins
 *wcc386 path.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tspins\sys.obj : e:\watcom\tspins\sys.c .AUTODEPEND
 @e:
 cd e:\watcom\tspins
 *wcc386 sys.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tspins\pathtest.exe : e:\watcom\tspins\path.obj e:\watcom\tspins\s&
ys.obj e:\watcom\tspins\path.h e:\watcom\tspins\sys.h .AUTODEPEND
 @e:
 cd e:\watcom\tspins
 @%write pathtest.lk1 NAME pathtest
 @%append pathtest.lk1 FIL path.obj,sys.obj
 @%append pathtest.lk1 
 *wlink SYS dos4g op m d all op st=8192 op maxe=25 op q op symf @pathtest.lk&
1

