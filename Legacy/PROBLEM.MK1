\watcom\tsp\problem.obj e:\watcom\tsp\set.obj e:\watcom\tsp\sys.obj e:\watco&
m\tsp\file.h e:\watcom\tsp\path.h e:\watcom\tsp\problem.h e:\watcom\tsp\set.&
h e:\watcom\tsp\sys.h .AUTODEPEND
