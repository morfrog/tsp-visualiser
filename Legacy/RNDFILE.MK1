!define BLANK ""
e:\watcom\tsp\file.obj : e:\watcom\tsp\file.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 file.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\rndfile.obj : e:\watcom\tsp\rndfile.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 rndfile.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\sys.obj : e:\watcom\tsp\sys.c .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 *wcc386 sys.c -i=e:\WATCOM\h -w4 -e25 -zq -otexan -d2 -mf -5r -bt=dos

e:\watcom\tsp\rndfile.exe : e:\watcom\tsp\file.obj e:\watcom\tsp\rndfile.obj&
 e:\watcom\tsp\sys.obj e:\watcom\tsp\file.h e:\watcom\tsp\sys.h .AUTODEPEND
 @e:
 cd e:\watcom\tsp
 @%write rndfile.lk1 NAME rndfile
 @%append rndfile.lk1 FIL file.obj,rndfile.obj,sys.obj
 @%append rndfile.lk1 
 *wlink SYS dos4g op m d all op st=8192 op maxe=25 op q op symf @rndfile.lk1

