\watcom\tsp\path.obj e:\watcom\tsp\problem.obj e:\watcom\tsp\screen.obj e:\w&
atcom\tsp\sys.obj e:\watcom\tsp\tspopt.obj e:\watcom\tsp\file.h e:\watcom\ts&
p\optim.h e:\watcom\tsp\path.h e:\watcom\tsp\problem.h e:\watcom\tsp\screen.&
