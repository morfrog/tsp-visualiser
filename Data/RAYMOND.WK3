struct point{
	double  x;
	double  y;
};

void
read_points(int pos)	/* Position into which this call of read_points
			 * should write. First call gets 0.
			 */
/*
 *  changes pointer "n" to point to array of double numbers
 *  changes int "size" to indicate size of array "n"
 */
{
	struct	point cityN;
	double	x, y;
	int	flag;


	flag = scanf("%lf %lf", &x, &y);

	if ( flag == 2 )
	{
		read_points(pos+1);
		n[pos].x = x;
		n[pos].y = y;
		return;
	}
	else
	if ( flag == EOF )
	{
		size = pos;
		n = (struct point *)(malloc(sizeof(struct point) * size));
		return;
	}
	else
	{
		fprintf(stderr,"read_points: read error, pos = %d\n", pos);
		exit(1);
	}
	
} /* read_points */


